---
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

const colorClass: Record<string, string> = {
  coral: 'bg-coral',
  sunny: 'bg-sunny',
  mint: 'bg-mint',
  sky: 'bg-sky',
  grape: 'bg-grape',
  peach: 'bg-peach',
};

const isLive = tool.status === 'live';
const Tag = isLive ? 'a' : 'div';
---

<Tag
  href={isLive ? `/${tool.slug}` : undefined}
  class:list={['card-pop block overflow-hidden', !isLive && 'opacity-75']}
>
  <div class:list={['flex h-24 items-center justify-center border-b-3 border-ink text-5xl', colorClass[tool.color] ?? 'bg-sunny']}>
    <span class={isLive ? 'wiggle' : undefined}>{tool.emoji}</span>
  </div>
  <div class="p-5">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-xl font-extrabold">{tool.name}</h3>
      {!isLive && (
        <span class="rounded-full border-2 border-ink bg-cream px-2 py-0.5 text-xs font-bold">soon</span>
      )}
    </div>
    <p class="text-sm font-semibold text-ink/50" style="font-family: var(--font-display);">{tool.nameEn}</p>
    <p class="mt-2 text-sm leading-relaxed text-ink/80">{tool.description}</p>
  </div>
</Tag>
